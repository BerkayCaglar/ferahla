{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ferahla rule file",
  "type": "object",
  "required": ["rules"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "rules": { "type": "array", "items": { "$ref": "#/$defs/rule" } }
  },
  "$defs": {
    "text": {
      "type": "object",
      "required": ["en", "tr"],
      "additionalProperties": false,
      "properties": { "en": { "type": "string", "minLength": 1 }, "tr": { "type": "string", "minLength": 1 } }
    },
    "strings": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
    "marker": {
      "enum": ["CargoToml", "PackageJson", "CsProj", "Sln", "UnityAssets", "UnityProjectSettings", "Git", "PyProject", "GoMod", "Gradle", "PomXml", "CMakeLists", "Pubspec", "ComposerJson", "MixExs", "StackYaml", "BuildZig", "UnrealProject", "GodotProject", "FsProj", "VbProj"]
    },
    "rule": {
      "type": "object",
      "required": ["id", "category", "risk", "match", "title"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+)+$" },
        "category": { "type": "string" },
        "risk": { "enum": ["safe", "regenerable", "review", "personal", "protected"] },
        "maturity": { "enum": ["pending", "release"], "default": "release" },
        "action": { "enum": ["quarantine", "command", "uninstall", "launcher", "info"], "default": "quarantine" },
        "command": { "type": "string" },
        "minBytes": { "type": "integer", "minimum": 0, "default": 10485760 },
        "keepRecentHours": { "type": "integer", "minimum": 1 },
        "title": { "$ref": "#/$defs/text", "description": "{name}, {parent}, {targets}, {count}, {product} are filled in." },
        "reason": { "$ref": "#/$defs/text" },
        "whatBreaks": { "$ref": "#/$defs/text" },
        "howToRestore": { "$ref": "#/$defs/text" },
        "match": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": { "$ref": "#/$defs/strings", "description": "%KnownFolder% tokens; * = one segment, ** = any depth." },
            "excludeNames": { "$ref": "#/$defs/strings", "description": "Folder names (globs) a path rule must not match." },
            "marker": { "type": "array", "items": { "$ref": "#/$defs/marker" }, "minItems": 1 },
            "targets": { "$ref": "#/$defs/strings" },
            "dirName": { "$ref": "#/$defs/strings" },
            "under": { "$ref": "#/$defs/strings" },
            "detector": { "type": "string" }
          },
          "oneOf": [
            { "required": ["path"] },
            { "required": ["marker", "targets"] },
            { "required": ["dirName"] },
            { "required": ["detector"] }
          ]
        }
      }
    }
  }
}
